{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flamehaven.nsrw-lean-build-request.v1",
  "title": "NSRW scoped Lean build request",
  "type": "object",
  "required": ["schema_id", "formal_source_commit", "toolchain", "targets"],
  "properties": {
    "schema_id": {"const": "flamehaven.nsrw-lean-build-request.v1"},
    "formal_source_commit": {"type": "string", "pattern": "^[0-9A-Fa-f]{40}$"},
    "toolchain": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["target", "module_source", "dependency_output"],
        "properties": {
          "target": {"type": "string", "pattern": "^\\+[A-Za-z0-9_.]+$"},
          "module_source": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$)).+\\.lean$"},
          "dependency_output": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.txt$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
