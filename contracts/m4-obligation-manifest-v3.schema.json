{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flamehaven.nsrw-m4-obligation-manifest.v3",
  "title": "NSRW M4-P hardened obligation manifest",
  "type": "object",
  "required": [
    "schema_id", "manifest_id", "stage", "compiled_evidence_mode",
    "canonicalization_profile", "source_binding", "required_mutations", "obligations"
  ],
  "properties": {
    "schema_id": {"const": "flamehaven.nsrw-m4-obligation-manifest.v3"},
    "manifest_id": {"type": "string", "minLength": 1},
    "stage": {"const": "M4-P"},
    "compiled_evidence_mode": {"enum": ["RECEIPT_REPLAY", "LIVE_ARTIFACT"]},
    "canonicalization_profile": {"const": "NSRW-CANONICAL-JSON-1"},
    "locator_evidence_class": {"const": "TEXTUAL_PINNED_SOURCE_LOCATOR"},
    "source_binding": {"$ref": "#/$defs/sourceBinding"},
    "required_mutations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/obligation"}
    },
    "extensions": {"type": "object"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"compiled_evidence_mode": {"const": "LIVE_ARTIFACT"}}},
      "then": {
        "properties": {
          "source_binding": {
            "properties": {
              "compiled_targets": {
                "additionalProperties": {
                  "allOf": [
                    {"$ref": "#/$defs/compiledTarget"},
                    {"required": ["dependency_surface_path", "dependency_surface_sha256"]}
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "sourceBinding": {
      "type": "object",
      "required": [
        "formal_source_commit", "formal_source_toolchain", "build_request_path",
        "input_bytes_sha256", "canonical_manifest_sha256", "compiled_targets"
      ],
      "properties": {
        "formal_source_commit": {"type": "string", "pattern": "^[0-9A-Fa-f]{40}$"},
        "formal_source_toolchain": {"type": "string", "minLength": 1},
        "build_request_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$)).+$"},
        "input_bytes_sha256": {"$ref": "#/$defs/hash"},
        "canonical_manifest_sha256": {"$ref": "#/$defs/hash"},
        "migration_receipt_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$)).+$"},
        "migration_receipt_sha256": {"$ref": "#/$defs/hash"},
        "compiled_targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/compiledTarget"}
        }
      },
      "additionalProperties": false
    },
    "compiledTarget": {
      "type": "object",
      "required": ["check_status", "receipt_path", "receipt_sha256", "olean_path", "olean_sha256"],
      "properties": {
        "check_status": {"enum": ["PASS", "HELD"]},
        "receipt_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$)).+$"},
        "receipt_sha256": {"$ref": "#/$defs/hash"},
        "olean_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$)).+\\.olean$"},
        "olean_sha256": {"$ref": "#/$defs/hash"},
        "dependency_surface_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$)).+\\.txt$"},
        "dependency_surface_sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "locator": {
      "type": "object",
      "required": ["relative_path", "declaration", "sha256", "signature_sha256", "quantifier_projection"],
      "properties": {
        "relative_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.(?:/|$)).+\\.lean$"},
        "declaration": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "signature_sha256": {"$ref": "#/$defs/hash"},
        "quantifier_projection": {"const": "NAMED_BINDERS_AND_DATA_EXISTENTIALS"},
        "locator_evidence_class": {"const": "TEXTUAL_PINNED_SOURCE_LOCATOR"}
      },
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "required": [
        "obligation_id", "family", "source_quantifiers", "artifact_quantifiers",
        "assumptions", "evidence_class", "claimed_scope", "constructibility",
        "compiled_target", "source_locator", "evaluator"
      ],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "family": {"enum": ["SUPPORT", "CONE", "MOMENT", "FALSIFICATION"]},
        "source_quantifiers": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/sourceQuantifier"}
        },
        "artifact_quantifiers": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/artifactQuantifier"}
        },
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_class": {
          "enum": [
            "FINITE_GRID", "COMPILED_TARGET", "MANUFACTURED_FALSIFIER",
            "MANUFACTURED_EXACT_CONTROL"
          ]
        },
        "claimed_scope": {
          "enum": ["SAMPLED_PARAMETRIC_DIAGNOSTIC", "SYMBOLIC_PARAMETRIC_IDENTITY", "SOURCE_INSTANCE"]
        },
        "constructibility": {
          "enum": [
            "EXPLICIT", "DERIVED_COMPUTABLE",
            "EXISTENTIAL__NO_PINNED_NUMERICAL_EVALUATOR",
            "EXISTENTIAL_NONCOMPUTABLE_IN_CURRENT_SOURCE_INTERFACE"
          ]
        },
        "compiled_target": {"type": "string", "minLength": 1},
        "source_locator": {"$ref": "#/$defs/locator"},
        "evaluator": {"type": "object"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"family": {"const": "SUPPORT"}}},
          "then": {"properties": {"evaluator": {"$ref": "#/$defs/supportEvaluator"}}}
        },
        {
          "if": {"properties": {"family": {"const": "CONE"}}},
          "then": {"properties": {"evaluator": {"$ref": "#/$defs/coneEvaluator"}}}
        },
        {
          "if": {"properties": {"family": {"const": "MOMENT"}}},
          "then": {"properties": {"evaluator": {"$ref": "#/$defs/momentEvaluator"}}}
        },
        {
          "if": {"properties": {"family": {"const": "FALSIFICATION"}}},
          "then": {"properties": {"evaluator": {"$ref": "#/$defs/falsificationEvaluator"}}}
        }
      ]
    },
    "sourceQuantifier": {
      "type": "object",
      "required": ["quantifier", "binder", "source_fragment"],
      "properties": {
        "quantifier": {"enum": ["FORALL", "EXISTS"]},
        "binder": {"type": "string", "minLength": 1},
        "source_fragment": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifactQuantifier": {
      "type": "object",
      "required": ["quantifier", "binder"],
      "properties": {
        "quantifier": {"enum": ["ONE_FIXTURE", "FINITE_GRID", "DECLARED"]},
        "binder": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "requiredAssumptions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "supportEvaluator": {
      "type": "object",
      "required": ["required_assumptions", "cutoff", "intervals", "boundary_policy"],
      "properties": {
        "required_assumptions": {"$ref": "#/$defs/requiredAssumptions"},
        "cutoff": {"type": "number", "exclusiveMinimum": 0},
        "intervals": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "lower", "upper"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "lower": {"type": "number", "minimum": 0},
              "upper": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "boundary_policy": {
          "type": "object",
          "required": ["allow_gaps", "allow_touching", "endpoint_convention"],
          "properties": {
            "allow_gaps": {"type": "boolean"},
            "allow_touching": {"type": "boolean"},
            "endpoint_convention": {"const": "CLOSED_CONTROL_INTERVALS"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coneEvaluator": {
      "type": "object",
      "required": [
        "required_assumptions", "threshold_dependencies", "threshold_values",
        "dependency_relation", "inequalities"
      ],
      "properties": {
        "required_assumptions": {"$ref": "#/$defs/requiredAssumptions"},
        "threshold_dependencies": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "threshold_values": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "dependency_relation": {"const": "STRICTLY_GREATER_THAN_DEPENDENCIES"},
        "inequalities": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "lhs", "relation", "rhs", "minimum_margin"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "lhs": {"type": "number"},
              "relation": {"enum": ["LE", "GE"]},
              "rhs": {"type": "number"},
              "minimum_margin": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "momentEvaluator": {
      "type": "object",
      "required": ["required_assumptions", "identities"],
      "properties": {
        "required_assumptions": {"$ref": "#/$defs/requiredAssumptions"},
        "identities": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "terms", "expected"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "terms": {
                "type": "array", "minItems": 1,
                "items": {"type": ["string", "integer"]}
              },
              "expected": {"type": ["string", "integer"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "falsificationEvaluator": {
      "type": "object",
      "required": ["required_assumptions"],
      "properties": {
        "required_assumptions": {"$ref": "#/$defs/requiredAssumptions"}
      },
      "additionalProperties": false
    }
  }
}
