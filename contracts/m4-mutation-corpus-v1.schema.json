{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flamehaven.nsrw-m4p-mutation-corpus.v1",
  "title": "NSRW staged M4-P mutation corpus",
  "type": "object",
  "required": ["schema_id", "baseline_fixture", "cases"],
  "properties": {
    "schema_id": {"const": "flamehaven.nsrw-m4p-mutation-corpus.v1"},
    "baseline_fixture": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": [
          "mutation_id", "full_manifest_expected_detector",
          "direct_evaluator_expected_detector", "direct_obligation_id",
          "applicable_evidence_modes", "allowed_secondary_detectors"
        ],
        "properties": {
          "mutation_id": {"type": "string", "minLength": 1},
          "full_manifest_expected_detector": {"type": "string", "minLength": 1},
          "direct_evaluator_expected_detector": {"type": "string", "minLength": 1},
          "direct_obligation_id": {"type": ["string", "null"]},
          "applicable_evidence_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["RECEIPT_REPLAY", "LIVE_ARTIFACT"]}
          },
          "allowed_secondary_detectors": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
