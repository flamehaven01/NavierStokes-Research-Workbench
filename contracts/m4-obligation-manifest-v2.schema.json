{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flamehaven.nsrw-m4-obligation-manifest.v2",
  "title": "NSRW M4 Parametric Obligation Manifest",
  "type": "object",
  "$defs": {
    "compiledTarget": {
      "type": "object",
      "required": ["check_status"],
      "properties": {
        "check_status": {"enum": ["PASS", "HELD"]},
        "receipt_path": {"type": "string", "minLength": 1},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "olean_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
      },
      "if": {"properties": {"check_status": {"const": "PASS"}}},
      "then": {"required": ["receipt_path", "receipt_sha256", "olean_sha256"]},
      "additionalProperties": false
    },
    "sourceQuantifier": {
      "type": "object",
      "required": ["quantifier", "binder", "source_fragment"],
      "properties": {
        "quantifier": {"enum": ["FORALL", "EXISTS"]},
        "binder": {"type": "string", "minLength": 1},
        "source_fragment": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifactQuantifier": {
      "type": "object",
      "required": ["quantifier", "binder"],
      "properties": {
        "quantifier": {"enum": ["FORALL", "EXISTS", "ONE_FIXTURE", "FINITE_GRID", "DECLARED"]},
        "binder": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_id", "manifest_id", "stage", "source_binding", "required_mutations", "obligations"],
  "properties": {
    "schema_id": {"const": "flamehaven.nsrw-m4-obligation-manifest.v2"},
    "manifest_id": {"type": "string", "minLength": 1},
    "stage": {"const": "M4-P"},
    "source_binding": {
      "type": "object",
      "required": ["formal_source_commit", "formal_source_toolchain", "compiled_targets"],
      "properties": {
        "formal_source_commit": {"type": "string", "pattern": "^[0-9A-Fa-f]{40}$"},
        "formal_source_toolchain": {"type": "string", "minLength": 1},
        "compiled_targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/compiledTarget"}
        }
      },
      "additionalProperties": true
    },
    "required_mutations": {"type": "array", "minItems": 6, "uniqueItems": true},
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "obligation_id", "family", "source_quantifiers", "artifact_quantifiers",
          "assumptions", "evidence_class", "claimed_scope", "constructibility",
          "compiled_target", "source_locator", "evaluator"
        ],
        "properties": {
          "source_quantifiers": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/sourceQuantifier"}
          },
          "artifact_quantifiers": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/artifactQuantifier"}
          },
          "source_locator": {
            "type": "object",
            "required": ["relative_path", "declaration", "sha256", "signature_sha256", "quantifier_projection"],
            "properties": {
              "relative_path": {"type": "string", "minLength": 1},
              "declaration": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
              "signature_sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
              "quantifier_projection": {"const": "NAMED_BINDERS_AND_DATA_EXISTENTIALS"}
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": true
}
